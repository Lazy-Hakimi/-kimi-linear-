    "head_dim": 128,
    "value_head_dim": 128,
    "conv_size": 4,
    "gate_low_rank": 128,
    "output_gate_low_rank": 128,
    "chunk_size": 128,
    "proj_bias": false,
    "conv_bias": true,
    "a_log_init": 0.0,
    "dt_bias_init": 0.0
  },
  "full_attn": {
    "num_heads": 16,
    "q_lora_rank": 1024,
    "kv_lora_rank": 512,
    "qk_nope_head_dim": 128,
    "qk_rope_head_dim": 0,
    "v_head_dim": 128,
    "rope_theta": 10000.0,
    "qkv_bias": false,
    "o_bias": false
  },
  "ffn": {
    "mode": "dense",
    "hidden_act": "silu",
    "intermediate_size": 5760,
    "moe": {
