{
  "model_type": "kimi_musicgpt",
  "architectures": ["KimiMusicGPT"],
  "comment": "Local on-device music GPT config (pure PyTorch trial training, sequence <= 8192; train window 2048-4096). Backbone section is a valid KimiLinearConfig document; the 'music' section is validated by MusicGPTConfig. torch_dtype reflects the V100 (sm_70) production run: fp16 is the only tensor-core path there (no bf16/tf32); the runtime dtype is chosen by --precision auto (kimi_linear/precision.py).",

  "vocab_size": 2056,
  "tie_word_embeddings": false,
  "max_position_embeddings": 8192,

  "hidden_size": 512,
  "num_hidden_layers": 12,
  "layer_pattern": ["kda", "kda", "kda", "mla"],
  "layer_pattern_repeat": 3,

  "rms_norm_eps": 1e-6,
  "l2norm_eps": 1e-6,
  "initializer_range": 0.02,
  "torch_dtype": "float16",

  "linear_attn": {
    "num_heads": 8,
    "head_dim": 64,
    "value_head_dim": 64,
    "conv_size": 4,
    "gate_low_rank": 64,
    "output_gate_low_rank": 64,
    "chunk_size": 64,
    "proj_bias": false,
    "conv_bias": true,
    "a_log_init": 0.0,
    "dt_bias_init": 0.0
  },

  "full_attn": {
    "num_heads": 8,
    "q_lora_rank": 256,
    "kv_lora_rank": 128,
    "qk_nope_head_dim": 64,
    "qk_rope_head_dim": 0,
    "v_head_dim": 64,
    "rope_theta": 10000.0,
    "qkv_bias": false,
    "o_bias": false
  },

  "ffn": {
    "mode": "dense",
    "hidden_act": "silu",
    "intermediate_size": 1024,
    "moe": {
      "n_routed_experts": 16,
      "num_experts_per_tok": 2,
      "n_shared_experts": 1,
      "moe_intermediate_size": 256,
      "routed_scaling_factor": 1.0,
      "norm_topk_prob": true,
      "scoring_func": "sigmoid",
      "first_k_dense_replace": 1,
      "aux_loss_coeff": 0.0
    }
  },

  "music": {
    "n_codebooks": 8,
    "codebook_size": 2048,
    "n_special": 8,
    "frame_rate": 25,
    "io_pattern": "delay",
    "delays": [0, 0, 0, 0, 0, 0, 0, 0],
    "pad_token_id": 2048,
    "bos_token_id": 2049,
    "eos_token_id": 2050,
    "mask_token_id": 2051,
    "semantic_slot_weight": 2.0,
    "structure": {
      "n_section": 8,
      "n_bar": 128,
      "n_beat": 16,
      "n_chord": 144,
      "n_tempo": 32
    },
    "condition": {
      "text_dim": 512,
      "text_layers": 4,
      "text_heads": 8,
      "text_max_len": 64,
      "melody_dim": 512,
      "n_styles": 16,
      "max_prefix_len": 256,
      "condition_dropout": 0.1
    }
  }
}
