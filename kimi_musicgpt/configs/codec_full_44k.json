{
  "model_type": "kimi_music_codec",
  "comment": "Kimi-Music-Codec full config (design doc §2): 44.1kHz, 25Hz frame rate, split-RVQ 1 semantic + 7 acoustic codebooks",

  "sample_rate": 44100,
  "channels": 1,

  "init_kernel": 7,
  "final_kernel": 7,
  "base_channels": 64,
  "channel_ratios": [1, 2, 4, 8, 16, 16, 16, 16],
  "strides": [2, 2, 2, 3, 3, 3, 2, 4],
  "kernel_size": 7,
  "residual_kernel_size": 7,
  "dilations": [1, 3, 9],
  "latent_dim": 1024,
  "norm": "weight_norm",
  "activation": "elu",

  "semantic": {
    "dim": 512,
    "codebook_size": 2048,
    "commitment_cost": 0.25
  },
  "acoustic": {
    "n_quantizers": 7,
    "codebook_size": 2048,
    "commitment_cost": 0.25,
    "rvq_dropout_p": 0.5
  },

  "ema_codebook": false,
  "dead_code_revival": true,
  "usage_threshold": 1e-5,

  "loss": {
    "stft_scales": [2048, 1024, 512, 256, 128],
    "mel_n_fft": 2048,
    "mel_hop": 512,
    "mel_n_mels": 80,
    "w_waveform": 1.0,
    "w_stft": 1.0,
    "w_mel": 10.0,
    "w_commitment": 1.0,
    "w_adversarial": 1.0,
    "w_feature_matching": 2.0
  },

  "discriminator": {
    "mpd_periods": [2, 3, 5, 7, 11],
    "mpd_channels": 32,
    "stft_ffts": [2048, 1024, 512],
    "stft_channels": 32
  }
}
