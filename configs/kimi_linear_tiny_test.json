{
  "model_type": "kimi_linear",
  "architectures": ["KimiLinearForCausalLM"],

  "vocab_size": 256,
  "tie_word_embeddings": true,
  "max_position_embeddings": 4096,

  "hidden_size": 64,
  "num_hidden_layers": 8,
  "layer_pattern": ["kda", "kda", "kda", "mla"],
  "layer_pattern_repeat": 2,

  "rms_norm_eps": 1e-6,
  "l2norm_eps": 1e-6,
  "initializer_range": 0.02,
  "torch_dtype": "float32",

  "linear_attn": {
    "num_heads": 2,
    "head_dim": 32,
    "value_head_dim": 32,
    "conv_size": 4,
    "gate_low_rank": 16,
    "output_gate_low_rank": 16,
    "chunk_size": 16,
    "proj_bias": false,
    "conv_bias": true,
    "a_log_init": 0.0,
    "dt_bias_init": 0.0
  },

  "full_attn": {
    "num_heads": 2,
    "q_lora_rank": 32,
    "kv_lora_rank": 16,
    "qk_nope_head_dim": 32,
    "qk_rope_head_dim": 8,
    "v_head_dim": 32,
    "rope_theta": 10000.0,
    "qkv_bias": false,
    "o_bias": false
  },

  "ffn": {
    "mode": "dense",
    "hidden_act": "silu",
    "intermediate_size": 128,
    "moe": {
      "n_routed_experts": 8,
      "num_experts_per_tok": 2,
      "n_shared_experts": 1,
      "moe_intermediate_size": 48,
      "routed_scaling_factor": 1.0,
      "norm_topk_prob": true,
      "scoring_func": "sigmoid",
      "first_k_dense_replace": 1,
      "aux_loss_coeff": 0.01
    }
  }
}
