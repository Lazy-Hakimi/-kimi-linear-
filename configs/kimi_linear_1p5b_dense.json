{
  "model_type": "kimi_linear",
  "architectures": ["KimiLinearForCausalLM"],

  "vocab_size": 131072,
  "tie_word_embeddings": true,
  "max_position_embeddings": 1048576,

  "hidden_size": 2048,
  "num_hidden_layers": 24,
  "layer_pattern": ["kda", "kda", "kda", "mla"],
  "layer_pattern_repeat": 6,

  "rms_norm_eps": 1e-6,
  "l2norm_eps": 1e-6,
  "initializer_range": 0.02,
  "torch_dtype": "float16",

  "linear_attn": {
    "num_heads": 16,
    "head_dim": 128,
    "value_head_dim": 128,
    "conv_size": 4,
    "gate_low_rank": 128,
    "output_gate_low_rank": 128,
    "chunk_size": 128,
    "tile_size": 0,
    "proj_bias": false,
    "conv_bias": true,
    "a_log_init": 0.0,
    "dt_bias_init": 0.0
  },

  "full_attn": {
    "num_heads": 16,
    "q_lora_rank": 1024,
    "kv_lora_rank": 512,
    "qk_nope_head_dim": 128,
    "qk_rope_head_dim": 0,
    "v_head_dim": 128,
    "rope_theta": 10000.0,
    "qkv_bias": false,
    "o_bias": false
  },

  "ffn": {
    "mode": "dense",
    "hidden_act": "silu",
    "intermediate_size": 5760,
    "moe": {
      "n_routed_experts": 64,
      "num_experts_per_tok": 6,
      "n_shared_experts": 1,
      "moe_intermediate_size": 1408,
      "routed_scaling_factor": 1.0,
      "norm_topk_prob": true,
      "scoring_func": "sigmoid",
      "first_k_dense_replace": 1,
      "aux_loss_coeff": 0.0
    }
  }
}
